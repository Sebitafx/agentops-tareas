# Variables documentadas: el servidor no carga este archivo automaticamente.
# RENDER: ambos servicios, misma base PostgreSQL, valor privado.
DATABASE_URL=
SERVICE_ROLE=receiver
APP_COMMIT=local
# RENDER: solo agentops-receiver.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALLOWED_SENDERS=
AGENT_APP_ID=
AGENT_APP_PRIVATE_KEY=
# ACTIONS: secretos del repo. AGENT_APP_ID y AGENT_APP_PRIVATE_KEY tambien.
GROQ_API_KEY=
RENDER_TASKS_DEPLOY_HOOK=
# ACTIONS: ritmo, no aumenta la cuota disponible.
GROQ_MIN_INTERVAL_SECONDS=65
# Opcional: comprobador independiente; no hay fallback automatico a Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=
# Pruebas: base aislada agentops_test, nunca Neon de la demo.
TEST_DATABASE_URL=
E2E_ENABLED=1
